/* Self-contained fallback styling: deliberately contains no external asset URLs. */
.inventory-panel-root {
    flex-grow: 1;
    position: relative;
    align-items: flex-start;
    justify-content: flex-start;
}

.inventory {
    width: 300px;
    padding: 10px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgb(35, 39, 47);
    border-width: 2px;
    border-color: rgb(105, 115, 130);
    border-radius: 6px;
}

.inventoryHeader {
    min-height: 42px;
    margin-bottom: 8px;
    justify-content: center;
    padding-left: 8px;
    background-color: rgb(53, 61, 74);
    border-radius: 4px;
}

.inventoryHeader Label {
    color: rgb(245, 245, 245);
    -unity-font-style: bold;
    font-size: 18px;
}

.slotsContainer {
    flex-grow: 1;
    flex-wrap: wrap;
    flex-direction: row;
    min-width: 0;
    align-items: flex-start;
    justify-content: flex-start;
}

.slot {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 4px;
    background-color: rgb(61, 68, 80);
    border-width: 1px;
    border-color: rgb(105, 115, 130);
}

.slotIcon {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.slotFrame {
    position: absolute;
    left: 0;
    top: 0;
    width: 60px;
    height: 60px;
    border-width: 1px;
    border-color: rgba(190, 200, 215, 0.35);
    background-color: rgba(0, 0, 0, 0);
}

.stackCount {
    position: absolute;
    right: 3px;
    bottom: 1px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.inventoryDragGhost {
    position: absolute;
    width: 48px;
    height: 48px;
    background-color: rgba(255, 220, 80, 0.35);
    border-width: 2px;
    border-color: rgb(255, 220, 80);
    visibility: visible;
}


.inventory-item-dragging {
    opacity: 0.35;
}

/* Fallback tint when an ItemDetails asset has no Icon Sprite assigned. */
.slotIconMissing {
    background-color: rgba(255, 0, 255, 0.12);
}

/* Item visuals occupy their parent slot; the slot itself is the drop target. */
.slotItem {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Grid inventory: cells are positioned by the view so item footprints can span them. */
.gridSlotsContainer {
    position: relative;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
}

.gridCell {
    margin: 0;
}

.gridCellBlocked {
    background-color: rgba(12, 14, 18, 0.92);
    border-width: 1px;
    border-color: rgb(45, 49, 57);
}

.gridSlotItem {
    background-color: rgba(90, 125, 165, 0.8);
    border-width: 1px;
    border-color: rgb(190, 210, 235);
    border-radius: 3px;
}


/* Live footprint preview while dragging a grid item. */
.gridPlacementPreview {
    position: absolute;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Color only the occupied preview cells. Never tint the empty area inside the
   item's bounding rectangle, which is especially important for irregular shapes. */
.gridPlacementPreview.valid .gridPlacementPreviewCell {
    background-color: rgba(55, 205, 105, 0.32);
    border-width: 1px;
    border-color: rgb(75, 235, 125);
    border-radius: 3px;
}

.gridPlacementPreview.invalid .gridPlacementPreviewCell {
    background-color: rgba(225, 55, 55, 0.34);
    border-width: 1px;
    border-color: rgb(255, 90, 90);
    border-radius: 3px;
}

/* Shared canvas fills the single UIDocument viewport. */
.inventory-panel-root {
    width: 100%;
    height: 100%;
    overflow: visible;
}

/* Grid dimensions are calculated from the available viewport by InventoryPanelView. */
.gridSlotsContainer {
    flex-shrink: 0;
}


#dragGhostImage {
    width: 100%;
    height: 100%;
}


/* Named equipment slots are rendered from EquipmentSlotLayout in stable layout order. */
.equipmentSlotsContainer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    max-width: 720px;
}

.equipmentSlot {
    width: 76px;
    height: 76px;
    margin: 5px;
    border-radius: 4px;
    background-color: rgb(49, 57, 69);
}

.equipmentSlotItem {
    background-color: rgba(90, 125, 165, 0.38);
}

.equipmentSlotLabel {
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 1px;
    min-height: 17px;
    padding-left: 2px;
    padding-right: 2px;
    color: rgb(245, 245, 245);
    background-color: rgba(15, 18, 24, 0.82);
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.equipmentSlot-valid {
    border-width: 2px;
    border-color: rgb(75, 235, 125);
    background-color: rgba(55, 205, 105, 0.3);
}

.equipmentSlot-invalid {
    border-width: 2px;
    border-color: rgb(255, 90, 90);
    background-color: rgba(225, 55, 55, 0.3);
}

/* Occupied cells are drawn individually so irregular item silhouettes leave real gaps. */
.gridSlotItem {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.gridItemOccupiedCell {
    background-color: rgba(90, 125, 165, 0.88);
    border-width: 1px;
    border-color: rgb(190, 210, 235);
    border-radius: 3px;
}

.gridPlacementPreview {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.gridPlacementPreviewCell {
    border-width: 2px;
    border-radius: 3px;
}

.gridPlacementPreview.valid .gridPlacementPreviewCell {
    background-color: rgba(55, 205, 105, 0.32);
    border-color: rgb(75, 235, 125);
}

.gridPlacementPreview.invalid .gridPlacementPreviewCell {
    background-color: rgba(225, 55, 55, 0.34);
    border-color: rgb(255, 90, 90);
}


/* Tooltip text defaults to white; per-item label styles may override the title. */
.inventoryItemTooltip {
    color: rgb(255, 255, 255);
}

.inventoryItemTooltip Label {
    color: rgb(255, 255, 255);
}

/* Grid item cells touch edge-to-edge; the view draws only exposed silhouette edges on hover. */
.gridItemOccupiedCell {
    border-width: 1px;
}
